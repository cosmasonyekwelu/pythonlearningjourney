{
  "scan_settings": {
    "common_ports": [21, 22, 23, 25, 53, 80, 110, 443, 993, 995, 3389],
    "scan_timeout": 2,
    "max_threads": 50
  },
  "monitoring_settings": {
    "check_interval": 30,
